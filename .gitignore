# Ignore user-generated data
user_data/
user_files/*
!user_files/README.txt

# Ignore local model files
local_models/

# Python cache files
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
.venv/
env/

# IDE configuration files
.idea/

# OS-generated metadata files
*.DS_Store
Thumbs.db
meta.json

# Local dependency upgrade backups (bundled libs/ is currently tracked)
libs.backup-*/
libs-backup-*/
libs.bak/
